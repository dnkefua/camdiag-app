# Backend API (Cloud Functions URL) - required for production AI features.
# Gemini/MedGemma API keys are server-only and must never be exposed as VITE_* variables.
VITE_API_URL=https://us-central1-<project-id>.cloudfunctions.net/api

# Google Maps Platform - enable: Maps JS API + Places API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase web config (Web app SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: Sentry error reporting
VITE_SENTRY_DSN=
