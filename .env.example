VITE_GOOGLE_AI_API_KEY=your_google_ai_api_key_here
VITE_GOOGLE_AI_MODEL=gemini-2.0-flash
VITE_USE_MEDGEMMA=false

# Google Maps Platform — enable: Maps JS API + Places API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase web config (Web app → SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend API (Cloud Functions URL) — set this for production to proxy Gemini calls server-side
# VITE_API_URL=https://us-central1-<project-id>.cloudfunctions.net/api

# Optional: Sentry error reporting
VITE_SENTRY_DSN=