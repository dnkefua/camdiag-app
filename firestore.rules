rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only read/write their own patient records
    match /patients/{docId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    // Users can only read/write their own scans
    match /scans/{docId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    // Anyone authenticated can read drugs, only admins can write
    match /drugs/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Managed via admin SDK or console
    }

    // Anyone authenticated can read facilities
    match /facilities/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Managed via admin SDK or console
    }

    // Anyone authenticated can read blog posts
    match /blog/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Managed via admin SDK or console
    }

    // Backend-only collections (accessed via Admin SDK, never from client)
    match /audit_logs/{docId} {
      allow read, write: if false; // Admin SDK only
    }

    match /rate_limits/{docId} {
      allow read, write: if false; // Admin SDK only
    }
  }
}