rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function clinical() {
      return signedIn()
        && request.auth.token.get('verifiedClinician', false) == true
        && request.auth.token.get('clinicalRole', '') in ['doctor', 'nurse']
        && request.auth.token.get('organizationId', '') is string
        && exists(/databases/$(database)/documents/clinical_memberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/clinical_memberships/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/clinical_memberships/$(request.auth.uid)).data.organizationId == request.auth.token.organizationId
        && get(/databases/$(database)/documents/clinical_memberships/$(request.auth.uid)).data.clinicalRole == request.auth.token.clinicalRole;
    }
    function ownsClinicalData() {
      return clinical() && resource.data.ownerUid == request.auth.uid
        && resource.data.organizationId == request.auth.token.organizationId;
    }
    function validProfile() {
      let d = request.resource.data;
      return (!('uid' in d) || d.uid == request.auth.uid)
        && (!('id' in d) || d.id == request.auth.uid)
        && (!('email' in d) || (d.email is string && d.email.size() <= 320))
        && (!('name' in d) || (d.name is string && d.name.size() <= 120))
        && (!('initials' in d) || (d.initials is string && d.initials.size() <= 10))
        && (!('about' in d) || (d.about is string && d.about.size() <= 1000))
        && (!('photoUrl' in d) || (d.photoUrl is string && d.photoUrl.size() <= 2000 && d.photoUrl.matches('https://.*')))
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('notificationPrefs' in d) || (d.notificationPrefs.keys().hasOnly(['scanResults','medicationAlerts','productUpdates'])
          && d.notificationPrefs.scanResults is bool && d.notificationPrefs.medicationAlerts is bool && d.notificationPrefs.productUpdates is bool));
    }
    function validProfileUpdate() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly(['email','name','initials','photoUrl','about','notificationPrefs'])
        && (!changed.hasAny(['email']) || (d.email is string && d.email.size() <= 320))
        && (!changed.hasAny(['name']) || (d.name is string && d.name.size() <= 120))
        && (!changed.hasAny(['initials']) || (d.initials is string && d.initials.size() <= 10))
        && (!changed.hasAny(['about']) || (d.about is string && d.about.size() <= 1000))
        && (!changed.hasAny(['photoUrl']) || (d.photoUrl is string && d.photoUrl.size() <= 2000 && d.photoUrl.matches('https://.*')))
        && (!changed.hasAny(['notificationPrefs']) || (d.notificationPrefs.keys().hasOnly(['scanResults','medicationAlerts','productUpdates'])
          && d.notificationPrefs.scanResults is bool && d.notificationPrefs.medicationAlerts is bool && d.notificationPrefs.productUpdates is bool));
    }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && validProfile()
        && request.resource.data.keys().hasOnly(['uid','id','email','name','initials','createdAt','photoUrl','about','notificationPrefs']);
      allow update: if signedIn() && request.auth.uid == userId && validProfileUpdate();
      allow delete: if false;
    }
    // The backend alone creates or changes clinical state, sources, outputs and attestations.
    match /{collection}/{id} {
      allow read: if collection in ['patients','encounters','documents','transcriptions','analyses','reviews','jobs','referral_events'] && ownsClinicalData();
      allow write: if false;
    }
    match /consents/{userId} { allow read: if signedIn() && request.auth.uid == userId; allow write: if false; }
    match /clinical_memberships/{userId} { allow read: if signedIn() && request.auth.uid == userId; allow write: if false; }
    match /scans/{id} { allow read: if clinical() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /drugs/{id} { allow read: if clinical() && resource.data.get('approved',false) == true; allow write: if false; }
    match /facilities/{id} { allow read: if signedIn(); allow write: if false; }
    match /blog/{id} { allow read: if signedIn(); allow write: if false; }
    // audit_logs, rate_limits, daily_budgets, upload slots, deletion requests,
    // consent events and medication evidence are exclusively backend-managed.
  }
}
